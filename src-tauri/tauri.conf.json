{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duolingo Desktop",
  "version": "0.1.0",
  "identifier": "com.tling0001.duolingodesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Duolingo",
      "width": 1280,
      "height": 820,
      "minWidth": 800,
      "minHeight": 600,
      "resizable": true,
      "center": true,
      "url": "index.html"
    }],
    "security": {
      "csp": "default-src 'self' https: data: blob:; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https:; connect-src 'self' https: wss:; font-src 'self' https: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Education",
    "shortDescription": "Learn a language with Duolingo",
    "longDescription": "A cross-platform desktop window for the official Duolingo learning experience."
  }
}
